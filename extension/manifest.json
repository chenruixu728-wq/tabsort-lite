{
  "manifest_version": 3,
  "name": "TabSort Lite Connector",
  "description": "Connects Edge to TabSort Lite for local tab organization.",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "nativeMessaging"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "连接 TabSort Lite" },
  "key": ""
}
